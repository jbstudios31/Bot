# Copiá este archivo a .env para correr el bot en local (no se sube a Git).
# En producción (Railway) estas mismas variables se cargan desde el dashboard.

TOKEN=                      # Token del bot de Discord
GROQ_API_KEY=                # API key de Groq (para las respuestas de IA)
FIREBASE_API_KEY=            # Web API key del proyecto Firebase (Project settings → General)
FIREBASE_BOT_EMAIL=          # Usuario creado en Firebase Console → Authentication
FIREBASE_BOT_PASSWORD=       # Password de ese usuario
CREADOR_ID=                  # (Opcional) ID de Discord del creador. Si está, la IA le habla con respeto/cariño a ese usuario.
